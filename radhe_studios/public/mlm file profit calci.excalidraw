      "boundElements": [],
      "updated": 1786339244548,
      "link": null,
      "locked": false,
      "text": "wallet earnings api\n\nget Api\ndata -leftBV: 0,\n            rightBV: 0,\n            totalLeftBV:0,\n            totalRightBV:0,\n            walletBalance: 0,\n            totalMatchingBonus: 0,\n            totalDirectBonus: 0,\n            totalEarning:0,\n            totalWithdrawn:0,\n            pendingPayout:0       \n     \n\n\n\n\nget api for Parrent node \n\n parentAgentId\n sponserId\n sponserName\n parrentAgentName\n\n\n\n\n\n\n \n \n",
      "fontSize": 113.58756586896732,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "wallet earnings api\n\nget Api\ndata -leftBV: 0,\n            rightBV: 0,\n            totalLeftBV:0,\n            totalRightBV:0,\n            walletBalance: 0,\n            totalMatchingBonus: 0,\n            totalDirectBonus: 0,\n            totalEarning:0,\n            totalWithdrawn:0,\n            pendingPayout:0       \n     \n\n\n\n\nget api for Parrent node \n\n parentAgentId\n sponserId\n sponserName\n parrentAgentName\n\n\n\n\n\n\n \n \n",
      "autoResize": true,
